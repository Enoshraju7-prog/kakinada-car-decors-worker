# Copy only for a separately configured PostgreSQL environment.
# scripts/setup_local.py generates the local cluster credentials and backend/.env.
KCD_DATABASE_URL=postgresql+psycopg://kcd_app:CHANGE_ME@127.0.0.1:5433/kcd_demo
KCD_TEST_DATABASE_URL=postgresql+psycopg://kcd_app:CHANGE_ME@127.0.0.1:5433/kcd_test
KCD_MODE=demo
# Optional AI: set your own authorized Azure endpoints/deployment/keys.
AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_DEPLOYMENT=claude-sonnet-4-6
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
